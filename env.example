# Локально: скопируй в .env.local и подставь свой ключ (файл .env.local в git не попадает).
# На Vercel: Project → Settings → Environment Variables → VITE_OPENROUTER_API_KEY,
# после добавления нужен новый деплой (Vite вшивает переменную при сборке).
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
